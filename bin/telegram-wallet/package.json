{
  "name": "miden-telegram-wallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build && node scripts/copy-worker-wasm.mjs",
    "build:static": "NEXT_STATIC_EXPORT=1 NEXT_PUBLIC_REMOTE_DIAGNOSTICS=0 NEXT_DIST_DIR=.next-static next build && node scripts/copy-worker-wasm.mjs .next-static/_next/static",
    "start": "next start -p 3005",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run"
  },
  "dependencies": {
    "@miden-sdk/miden-sdk": "0.17.5",
    "@noble/curves": "1.9.7",
    "@openzeppelin/guardian-client": "0.18.1",
    "@openzeppelin/miden-multisig-client": "0.18.1",
    "@privy-io/react-auth": "3.43.0",
    "next": "15.5.26",
    "qrcode": "1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "overrides": {
    "ws": "8.22.0",
    "source-map-js": "1.2.2",
    "@miden-sdk/miden-sdk": "$@miden-sdk/miden-sdk"
  }
}
