# Privy app (dashboard.privy.io): Telegram login enabled with the bot's token,
# "direct Mini App authentication" on, and this app's origins allowed.
NEXT_PUBLIC_PRIVY_APP_ID=
# Only when the Privy app has more than one client.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Local testing outside Telegram: also offer email login (enable email in Privy too).
# NEXT_PUBLIC_DEV_EMAIL_LOGIN=1

# Guardian 0.18 on the same Miden network.
NEXT_PUBLIC_GUARDIAN_ENDPOINT=https://guardian-testnet.openzeppelin.com
NEXT_PUBLIC_MIDEN_NETWORK=testnet
NEXT_PUBLIC_MIDEN_RPC_URL=https://rpc.testnet.miden.io
NEXT_PUBLIC_MIDEN_NOTE_TRANSPORT_URL=https://transport.miden.io
# Phones prove slowly: a remote prover, with this device as the fallback. It
# sees each transaction's full inputs. Unset or `local` proves on the phone.
NEXT_PUBLIC_MIDEN_PROVER_URL=https://tx-prover.testnet.miden.io
# Devnet needs the invitation code; testnet takes none.
# NEXT_PUBLIC_MIDEN_REGISTRATION_CODE=

# The mini app's Telegram link (BotFather), e.g. https://t.me/MidenWalletBot/wallet.
# Receive > Share then sends a pay link that opens Send filled in.
# NEXT_PUBLIC_TELEGRAM_APP_URL=
# Payment alerts server (alerts/, AWS Lambda function URL); unset: no alerts.
# NEXT_PUBLIC_ALERTS_URL=
# The bot id (the part of its token before the colon; public): checks Telegram-signed directory proofs.
# NEXT_PUBLIC_TELEGRAM_BOT_ID=
